{
  "compilerOptions": {
    "target": "ES2022", "useDefineForClassFields": true, "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "allowImportingTsExtensions": false,
    "verbatimModuleSyntax": true, "allowJs": false, "skipLibCheck": true, "esModuleInterop": true,
    "allowSyntheticDefaultImports": true, "strict": true, "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true, "isolatedModules": true, "noEmit": true, "jsx": "react-jsx", "types": ["vite/client"]
  },
  "include": ["src", "vite.config.ts"]
}
